---
import BlogDetail from '../../../views/Blog/Detail/index.astro';
import { setLocale, type Locale } from '../../../i18n/i18n';
import MainLayout from '../../../layouts/MainLayout.astro';
import { formatMarkdownHtml, resolveMarkdownCompiledContent } from '../../../components/blog/markdownFormat';

const BLOG_PREVIEW_PLACEHOLDER = '/images/blog/placeholder.jpg';

export async function getStaticPaths() {
  const locales = ['en', 'es'];
  const paths: any[] = [];
  const modules = import.meta.glob('../../../locales/*/blog/*.md');
  for (const locale of locales) {
    const allPosts: any[] = [];
    for (const p in modules) {
      const parts = p.split('/');
      const fileLocale = parts[4];
      if (fileLocale !== locale) continue;
      const mod: any = await modules[p]();
      const fm = mod.frontmatter || {};
      if (fm && fm.slug && fm.id) {
        const rawContent = await resolveMarkdownCompiledContent(mod);
        const content = formatMarkdownHtml(rawContent);
        const preview = fm.preview ? String(fm.preview) : BLOG_PREVIEW_PLACEHOLDER;
        const image = fm.image ? String(fm.image) : '';
        allPosts.push({ ...fm, content, preview, image });
      }
    }
    for (const blogPost of allPosts) {
      paths.push({
        params: { lang: locale, blogId: blogPost.slug || blogPost.id },
        props: { blogPost, currentLang: locale as Locale, allBlogPosts: allPosts }
      });
    }
  }
  return paths;
}

const { blogPost, currentLang, allBlogPosts } = Astro.props;
const { lang } = Astro.params;

setLocale(lang as Locale);

const pageTitle = blogPost.meta_title || blogPost.title;
const pageDescription = blogPost.meta_description || blogPost.summary || '';
---
<MainLayout title={pageTitle} description={pageDescription}>
  <BlogDetail blogPost={blogPost} currentLang={currentLang} allBlogPosts={allBlogPosts} />
</MainLayout>
